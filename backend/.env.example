# Railway injects DATABASE_URL automatically when you add a PostgreSQL service.
DATABASE_URL=postgresql://user:password@host:5432/wtr
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-app.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
FRONTEND_URL=https://your-frontend.vercel.app
# First platform super admin (created by `seed_platform` if no super admin exists)
PLATFORM_ADMIN_EMAIL=admin@wtr.gh
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
PLATFORM_ADMIN_NAME=Platform Administrator
# Optional integrations
SMS_PROVIDER=console          # console | arkesel | hubtel
SMS_API_KEY=
SMS_SENDER_ID=WTRGH
PAYSTACK_SECRET_KEY=
ANTHROPIC_API_KEY=
